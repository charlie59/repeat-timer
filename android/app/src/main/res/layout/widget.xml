<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <ImageView
        android:id="@+id/widget_start"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_btn_go"
        android:contentDescription="Start timer"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_play" />

    <LinearLayout
        android:id="@+id/widget_center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8a8a8a"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Autosize grows the time to fill the space left (Android 8+; older phones use textSize). -->
        <Chronometer
            android:id="@+id/widget_time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_idle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeMinTextSize="20sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="03:00"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_stop"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_btn_stop"
        android:contentDescription="Stop timer"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_stop" />
</LinearLayout>
